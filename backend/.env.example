# ============================================================
#  SALUDPLUS — Variables de entorno
#  Copiar a .env y completar con valores reales.
#  NUNCA subir este archivo a git (está en .gitignore).
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# URL del proyecto (Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anónima — lectura pública (Settings > API > anon public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio — acceso total, solo en backend (Settings > API > service_role)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Anthropic ─────────────────────────────────────────────────
# API Key de Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Admin JWT ─────────────────────────────────────────────────
# Secreto para firmar tokens JWT del panel admin.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Algoritmo JWT (no cambiar)
JWT_ALGORITHM=HS256

# Expiración del token en minutos
JWT_EXPIRE_MINUTES=480

# ── Credenciales del admin ────────────────────────────────────
# Contraseña en texto plano; se hashea en memoria al arrancar.
# En producción usa un hash bcrypt generado offline.
ADMIN_EMAIL=admin@saludplus.pe
ADMIN_PASSWORD=CambiarEstaContraseña2024!

# ── CORS ──────────────────────────────────────────────────────
# Orígenes permitidos separados por coma.
# En producción reemplazar * por el dominio real del frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://saludplus.pe

# ── Entorno ───────────────────────────────────────────────────
ENVIRONMENT=development
